#!/bin/bash
# Show MiMoCode usage or force a refresh.
# Usage is auto-calculated from session databases — no manual input needed.
#
# Usage:
#   mimocode-usage              # show current usage
#   mimocode-usage refresh      # force panel refresh

set -euo pipefail

CONFIG="$HOME/.config/mimocode/usage-config.json"
USAGE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/omarchy/agents/usage"
COLLECTOR="$HOME/.local/bin/collect-mimocode-usage"

if [[ "${1:-}" == "refresh" ]]; then
    mkdir -p "$USAGE_DIR"
    python3 "$COLLECTOR" > "$USAGE_DIR/mimocode.json"
    echo "Panel data refreshed."
    exit 0
fi

# Show current state
python3 "$COLLECTOR" 2>/dev/null | python3 -c "
import json, sys
d = json.load(sys.stdin)
l = d.get('limits', [])
if l:
    print(f'Credits: {l[0][\"percent\"]*100:.1f}%')
print(f'Prompts: {d[\"totalPrompts\"]}')
print(f'Sessions: {d[\"totalSessions\"]}')
print(f'Active days: {d[\"activeDays\"]}')
print(f'Models: {len(d[\"modelUsage\"])}')
"
